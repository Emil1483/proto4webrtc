<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_interfaces</name>
  <version>0.0.1</version>
  <description>
    Messages and services generated from ../../../proto by
    proto4webrtc_codegen.ros2 at CMake configure time (see CMakeLists.txt).
  </description>
  <maintainer email="emil@djupvik.dev">user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- proto4webrtc-codegen is a pip dist, not a rosdep key: declaring it here
       would only make `rosdep install` fail. The robot image installs it (see
       robot/Dockerfile); the generator runs under the same interpreter CMake
       finds as Python3_EXECUTABLE. -->

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
